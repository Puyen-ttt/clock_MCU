  13          
  14          void flash_write_byte(unsigned int address, unsigned char value)
  15          {
  16   1          // Erase page
  17   1          IAPAL = (unsigned char)(address & 0xFF); //high
  18   1          IAPAH = (unsigned char)(address >> 8); //low
  19   1          IAPFD = 0xFF;
  20   1          IAPCN = 0x22;
  21   1      
  22   1          EAL = 0; //disable ngat toan cuc
  23   1          IAPTRG = 0x01;
  24   1          _nop_(); _nop_();
  25   1          EAL = 1; 
  26   1      
  27   1          // Program byte
  28   1          IAPAL = (unsigned char)(address & 0xFF);
  29   1          IAPAH = (unsigned char)(address >> 8);
  30   1          IAPFD = value;
  31   1          IAPCN = 0x21;
  32   1      
  33   1          EAL = 0;
  34   1          IAPTRG = 0x01;
  35   1          _nop_(); _nop_(); //no operation
  36   1          EAL = 1;
  37   1      }
  38          
  39          unsigned char flash_read_byte(unsigned int address)
  40          {
  41   1          unsigned char value;
  42   1      
  43   1          IAPAL = (unsigned char)(address & 0xFF);
  44   1          IAPAH = (unsigned char)(address >> 8);
  45   1          IAPCN = 0x00;
  46   1      
  47   1          IAPTRG = 0x01;
  48   1          _nop_(); _nop_();
  49   1      
  50   1          value = IAPFD;
  51   1          return value;
  52   1      }
