  54          void flash_save_alarm_time(unsigned char hour, unsigned char minute)
  55          {
  56   1          flash_write_byte(ALARM_FLASH_ADDR_HOUR, hour);
  57   1          flash_write_byte(ALARM_FLASH_ADDR_MINUTE, minute);
  58   1      }
  59          
  60          void flash_read_alarm_time(unsigned char* hour, unsigned char* minute)
  61          {
  62   1          *hour = flash_read_byte(ALARM_FLASH_ADDR_HOUR);
  63   1          *minute = flash_read_byte(ALARM_FLASH_ADDR_MINUTE);
  64   1      
  65   1          if (*hour > 23) *hour = 0;
